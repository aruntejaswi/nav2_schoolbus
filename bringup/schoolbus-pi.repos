# Schoolbus manifest — Raspberry Pi workspace (sensors + motors + RC).
#
# The Pi runs hardware drivers only. Nav2, SLAM, Nav2, and kiss-icp run on
# the laptop — do NOT add nav2_schoolbus or kiss-icp here.
#
# Usage:
#   cd ~/ros2_ws
#   vcs import src < bringup/schoolbus-pi.repos
#   rosdep install --from-paths src --ignore-src -r -y
#   colcon build --symlink-install
#
# Or just run bringup/bootstrap.sh --target pi

repositories:
  control_tower_ros2:
    type: git
    url: https://github.com/LTU-Actor/control_tower_ros2.git
    version: main
  ibus_reader:
    type: git
    url: https://github.com/LTU-Actor/ibus_reader.git
    version: main
  mqtt_wheel_bridge:
    type: git
    url: https://github.com/LTU-Actor/mqtt_wheel_bridge.git
    version: master
  ractor_pi_launches:
    type: git
    url: https://github.com/LTU-Actor/ractor_pi_launches.git
    version: master
  schoolbus_description:
    type: git
    url: https://github.com/LTU-Actor/schoolbus_description.git
    version: master
  imu_serial_to_ros_publisher:
    type: git
    url: https://github.com/Aeolus96/imu_serial_to_ros_publisher.git
    version: main
