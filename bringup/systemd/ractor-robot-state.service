[Unit]
Description=ractor robot_state_publisher (URDF TF tree)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
ExecStart=/bin/bash -c "source /home/pi/.bashrc && source /home/pi/ros2_ws/install/setup.bash && ros2 launch schoolbus_urdf schoolbus.launch.py"
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
